---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Greca from '../components/deco/Greca.astro';
import PcbCorners from '../components/deco/PcbCorners.astro';
import { tiers, confirmados } from '../data/sponsors';
import { site } from '../data/site';
import { textos } from '../i18n';

const txt = textos(Astro.url);
const t = txt.paginaSponsors;

/* El color de cada nivel vive en sponsors.ts; su nombre y sus beneficios, en
   los archivos de idioma. Mismo orden en los dos. */
const niveles = tiers.map((tier, i) => ({ ...tier, ...txt.tiers[i] }));
---

<Base pagina="sponsors">
  <!-- ── Portada ─────────────────────────────────────── -->
  <section class="portada">
    <PcbCorners esquinas={['si', 'id']} tam={170} opacidad={0.45} />
    <div class="portada__caja">
      <p class="label portada__etiqueta">{t.etiquetaPortada}</p>
      <h1 class="display portada__titulo">
        {t.tituloInicio}<span class="portada__resalte">{t.tituloResalte}</span>{t.tituloFin}
      </h1>
      <p class="portada__lema">
        {t.lemaInicio}{txt.fechas.etiquetaLarga}{t.lemaFin}
      </p>
      <div class="portada__acciones">
        <a href={`mailto:${site.contacto.emailSponsors}`} class="btn btn-activo portada__cta">
          {t.cta}
        </a>
        <a href="#niveles" class="btn btn-activo portada__cta-2">{t.cta2}</a>
      </div>
    </div>
    <Greca alto={20} variante="tres" />
  </section>

  <!-- ── Por qué ─────────────────────────────────────── -->
  <Section etiqueta={t.etiquetaArgumento} titulo={t.tituloArgumento} ancho="angosto">
    <div class="argumento">
      {
        t.argumento.map((a, i) => (
          <article class="argumento__bloque">
            <p class="label argumento__numero">{String(i + 1).padStart(2, '0')}</p>
            <div>
              <h3 class="display argumento__titulo">{a.titulo}</h3>
              <p class="argumento__texto">{a.texto}</p>
            </div>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- ── Qué ofrecemos ───────────────────────────────── -->
  <Section fondo="cal2" etiqueta={t.etiquetaOfrecemos} titulo={t.tituloOfrecemos}>
    <ul class="ofrecemos">
      {
        t.ofrecemos.map((o) => (
          <li class="ofrece">
            <h3 class="display ofrece__titulo">{o.titulo}</h3>
            <p class="ofrece__texto">{o.texto}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- ── Niveles ─────────────────────────────────────── -->
  <Section
    id="niveles"
    etiqueta={t.etiquetaNiveles}
    titulo={t.tituloNiveles}
    entradilla={t.entradillaNiveles}
  >
    <ul class="niveles">
      {
        niveles.map((n) => (
          <li class:list={['nivel', `nivel--${n.color}`]}>
            <header class="nivel__cabeza">
              <h3 class="display nivel__nombre">{n.nombre}</h3>
              <p class="nivel__resumen">{n.resumen}</p>
            </header>
            <ul class="nivel__beneficios">
              {n.beneficios.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- ── A dónde va ──────────────────────────────────── -->
  <Section fondo="cal2" etiqueta={t.etiquetaDestino} titulo={t.tituloDestino} ancho="angosto">
    <div class="destino">
      <ul class="destino__lista">
        {t.destino.map((d) => <li>{d}</li>)}
      </ul>
      <aside class="destino__nota">
        <h3 class="display destino__nota-titulo">{t.tituloComprobamos}</h3>
        <p>{t.textoComprobamos}</p>
      </aside>
    </div>
  </Section>

  {
    confirmados.length > 0 && (
      <Section etiqueta={t.etiquetaGracias} titulo={t.tituloGracias}>
        <ul class="confirmados">
          {confirmados.map((c) => (
            <li>
              <a href={c.url} target="_blank" rel="noopener noreferrer">
                <img src={`/media/sponsors/${c.logo}`} alt={c.nombre} loading="lazy" height="56" />
              </a>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <!-- ── Cierre ──────────────────────────────────────── -->
  <Section fondo="tinta" pcb={false} ancho="angosto">
    <div class="cierre">
      <h2 class="display cierre__titulo">{t.tituloCierre}</h2>
      <p class="cierre__texto">{t.textoCierre}</p>
      <a href={`mailto:${site.contacto.emailSponsors}`} class="btn btn-activo cierre__cta">
        {site.contacto.emailSponsors}
      </a>
    </div>
  </Section>
</Base>

<style>
  /* ── Portada ─────────────────────────────────────── */
  .portada {
    position: relative;
    overflow: hidden;
  }
  .portada__caja {
    max-width: 60rem;
    margin-inline: auto;
    padding: clamp(3rem, 7vw, 5.5rem) 1.25rem clamp(2.5rem, 5vw, 4rem);
  }
  .portada__etiqueta {
    color: var(--color-cobre-2);
    margin-bottom: 1rem;
  }
  .portada__titulo {
    font-size: var(--text-5xl);
    max-width: 18ch;
  }
  .portada__resalte {
    color: var(--color-cobre);
  }
  .portada__lema {
    margin-top: 1.5rem;
    font-size: var(--text-lg);
    color: var(--color-tinta-2);
    max-width: 58ch;
  }
  .portada__acciones {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }
  .portada__cta {
    background: var(--color-rosa);
    color: var(--color-cal);
  }
  .portada__cta-2 {
    background: var(--color-cal);
    color: var(--color-tinta);
  }

  /* ── Argumento ───────────────────────────────────── */
  .argumento {
    display: grid;
    gap: 2.5rem;
  }
  .argumento__bloque {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1.25rem;
    border-top: 2px solid var(--color-tinta);
    padding-top: 1.25rem;
  }
  .argumento__numero {
    color: var(--color-cobre-2);
    font-size: var(--text-base);
  }
  .argumento__titulo {
    font-size: var(--text-2xl);
    margin-bottom: 0.7rem;
  }
  .argumento__texto {
    color: var(--color-tinta-2);
    font-size: var(--text-lg);
  }

  /* ── Ofrecemos ───────────────────────────────────── */
  .ofrecemos {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1px;
    background: var(--color-cal-3);
    border: 2px solid var(--color-tinta);
    border-radius: 2px;
    overflow: hidden;
  }
  .ofrece {
    background: var(--color-cal);
    padding: 1.5rem;
  }
  .ofrece__titulo {
    font-size: var(--text-lg);
    color: var(--color-cobre-2);
    margin-bottom: 0.5rem;
  }
  .ofrece__texto {
    color: var(--color-tinta-2);
  }

  /* ── Niveles ─────────────────────────────────────── */
  .niveles {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.5rem;
  }
  .nivel {
    border: 2px solid var(--color-tinta);
    border-top-width: 6px;
    border-top-color: var(--nivel-color);
    border-radius: 2px;
    background: var(--color-cal);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
  }
  .nivel--cobre {
    --nivel-color: var(--color-cobre);
  }
  .nivel--agave {
    --nivel-color: var(--color-agave);
  }
  .nivel--talavera {
    --nivel-color: var(--color-talavera);
  }
  .nivel--rosa {
    --nivel-color: var(--color-rosa);
  }
  .nivel__nombre {
    font-size: var(--text-2xl);
    color: var(--nivel-color);
  }
  .nivel__resumen {
    margin-top: 0.5rem;
    color: var(--color-tinta-2);
    font-size: var(--text-base);
  }
  .nivel__beneficios {
    margin: 1.25rem 0 0;
    padding: 1.25rem 0 0 0;
    border-top: 1px solid var(--color-cal-3);
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }
  .nivel__beneficios li {
    position: relative;
    padding-left: 1.5rem;
    font-size: var(--text-base);
    color: var(--color-tinta);
  }
  /* Palomita dibujada con dos bordes: sin fuente de iconos. */
  .nivel__beneficios li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.45em;
    width: 6px;
    height: 10px;
    border: solid var(--nivel-color);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  /* ── Destino ─────────────────────────────────────── */
  .destino {
    display: grid;
    gap: 2rem;
  }
  .destino__lista {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  .destino__lista li {
    border-bottom: 1px solid var(--color-cal-3);
    padding-bottom: 0.75rem;
    font-size: var(--text-lg);
    color: var(--color-tinta);
  }
  .destino__nota {
    background: var(--color-cal);
    border: 2px solid var(--color-tinta);
    border-radius: 2px;
    padding: 1.5rem;
    box-shadow: 5px 5px 0 var(--color-agave);
    align-self: start;
  }
  .destino__nota-titulo {
    font-size: var(--text-xl);
    margin-bottom: 0.6rem;
  }
  .destino__nota p {
    color: var(--color-tinta-2);
    font-size: var(--text-base);
  }

  /* ── Confirmados ─────────────────────────────────── */
  .confirmados {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2.5rem;
  }

  /* ── Cierre ──────────────────────────────────────── */
  .cierre {
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 1.25rem;
  }
  .cierre__titulo {
    font-size: var(--text-4xl);
  }
  .cierre__texto {
    color: color-mix(in srgb, var(--color-cal) 78%, transparent);
    font-size: var(--text-lg);
    max-width: 52ch;
  }
  .cierre__cta {
    margin-top: 0.5rem;
    /* Ver nota en SponsorsResumen: cobre + texto claro no pasa AA. */
    background: var(--color-cobre-claro);
    color: var(--color-tinta);
    border-color: var(--color-cal);
    box-shadow: 4px 4px 0 var(--color-cal);
    text-transform: none;
    letter-spacing: 0.02em;
    overflow-wrap: anywhere;
  }
  .cierre__cta:hover {
    box-shadow: 2px 2px 0 var(--color-cal);
  }
  .cierre__cta:active {
    box-shadow: 0 0 0 var(--color-cal);
  }

  @media (min-width: 720px) {
    .ofrecemos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .niveles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .destino {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }
  @media (min-width: 1024px) {
    .niveles {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
