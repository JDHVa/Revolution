---
import Section from './Section.astro';
import { site } from '../data/site';
import { textos } from '../i18n';

const { venue } = site;
const t = textos(Astro.url).sede;
---

<Section
  id="sede"
  fondo="cal2"
  etiqueta={t.etiqueta}
  titulo={t.titulo}
  entradilla={venue.confirmado ? undefined : t.nota}
>
  <div class="sede">
    <div class="sede__datos">
      {
        venue.confirmado ? (
          <>
            <h3 class="display sede__nombre">{t.nombre}</h3>
            {venue.direccion && <p class="sede__direccion">{venue.direccion}</p>}
            <p class="sede__ciudad label">{t.ciudad}</p>
            {venue.mapa && (
              <a
                href={venue.mapa}
                class="btn btn-activo sede__cta"
                target="_blank"
                rel="noopener noreferrer"
              >
                {t.verMapa}
              </a>
            )}
          </>
        ) : (
          <>
            <p class="pendiente">{t.pendiente}</p>
            <h3 class="display sede__nombre">{t.ciudad}</h3>
            {t.textos.map((texto) => (
              <p class="sede__texto">{texto}</p>
            ))}
          </>
        )
      }
    </div>

    <ul class="sede__incluye">
      {
        t.incluye.map((i) => (
          <li>
            <h4 class="display">{i.titulo}</h4>
            <p>{i.texto}</p>
          </li>
        ))
      }
    </ul>
  </div>
</Section>

<style>
  .sede {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  .sede__nombre {
    font-size: var(--text-3xl);
    margin-top: 0.9rem;
  }

  .sede__direccion,
  .sede__texto {
    margin-top: 0.9rem;
    color: var(--color-tinta-2);
    font-size: var(--text-lg);
    max-width: 52ch;
  }

  .sede__ciudad {
    margin-top: 0.6rem;
    color: var(--color-tinta-2);
  }

  .sede__cta {
    margin-top: 1.5rem;
    background: var(--color-cal);
    color: var(--color-tinta);
  }

  .sede__incluye {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1px;
    background: var(--color-cal-3);
    border: 2px solid var(--color-tinta);
    border-radius: 2px;
    overflow: hidden;
  }

  .sede__incluye li {
    background: var(--color-cal);
    padding: 1.25rem 1.4rem;
  }

  .sede__incluye h4 {
    font-size: var(--text-lg);
    margin-bottom: 0.35rem;
  }

  .sede__incluye p {
    color: var(--color-tinta-2);
    font-size: var(--text-base);
  }

  @media (min-width: 880px) {
    .sede {
      grid-template-columns: 1.1fr 1fr;
      gap: 3.5rem;
    }
  }
</style>
