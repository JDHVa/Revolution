---
import Section from './Section.astro';
import { workshops } from '../data/workshops';
import { textos } from '../i18n';

const c = textos(Astro.url);
const t = c.talleres;

/* Los datos duros están en workshops.ts y el texto en los archivos de idioma,
   en el mismo orden. Aquí se juntan. */
const talleres = workshops.map((w, i) => ({ ...w, ...t.lista[i] }));
---

<Section
  id="talleres"
  etiqueta={t.etiqueta}
  titulo={t.titulo}
  entradilla={t.entradilla}
>
  <ol class="talleres">
    {
      talleres.map((w) => (
        <li class="taller">
          <p class="label taller__numero">
            {t.numero} {String(w.numero).padStart(2, '0')}
          </p>

          <h3 class="display taller__titulo">{w.titulo}</h3>
          <p class="taller__descripcion">{w.descripcion}</p>

          <dl class="taller__datos">
            <div>
              <dt class="label">{t.cuando}</dt>
              <dd>{w.fecha ?? <span class="taller__pendiente">{w.cuando}</span>}</dd>
            </div>
            <div>
              <dt class="label">{t.donde}</dt>
              <dd>{w.sede ?? <span class="taller__pendiente">{c.ui.porConfirmar}</span>}</dd>
            </div>
            <div>
              <dt class="label">{t.imparten}</dt>
              <dd>{w.imparten.join(t.unirNombres)}</dd>
            </div>
          </dl>

          {w.registro ? (
            <a href={w.registro} class="btn btn-activo taller__cta">
              {t.apartar}
            </a>
          ) : (
            <p class="pendiente taller__cta">{c.ui.registroPronto}</p>
          )}
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .talleres {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.5rem;
  }

  .taller {
    background: var(--color-cal);
    border: 2px solid var(--color-tinta);
    border-radius: 2px;
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    /* Empuja el CTA al fondo para que las tres tarjetas alineen abajo. */
    gap: 0.75rem;
  }

  .taller__numero {
    color: var(--color-cobre-2);
  }

  .taller__titulo {
    font-size: var(--text-xl);
    line-height: 1.1;
  }

  .taller__descripcion {
    color: var(--color-tinta-2);
    font-size: var(--text-base);
  }

  .taller__datos {
    margin-top: auto;
    padding-top: 1rem;
    display: grid;
    gap: 0.7rem;
    border-top: 1px solid var(--color-cal-3);
  }
  .taller__datos dt {
    color: var(--color-tinta-2);
    margin-bottom: 0.15rem;
  }
  .taller__datos dd {
    margin: 0;
    font-size: var(--text-base);
    color: var(--color-tinta);
  }

  .taller__pendiente {
    color: var(--color-tinta-2);
    font-style: italic;
  }

  .taller__cta {
    margin-top: 1rem;
    width: 100%;
    text-align: center;
  }
  a.taller__cta {
    background: var(--color-cal);
    color: var(--color-tinta);
  }

  @media (min-width: 880px) {
    .talleres {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.75rem;
    }
  }
</style>
