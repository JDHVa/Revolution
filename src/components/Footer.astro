---
import Wordmark from './Wordmark.astro';
import Greca from './deco/Greca.astro';
import { site, disponible } from '../data/site';
import { idiomaDe, ruta, textos } from '../i18n';

const anio = new Date().getFullYear();

const txt = textos(Astro.url);
const t = txt.footer;
const idioma = idiomaDe(Astro.url);
/* Todos los links del pie se quedan dentro del idioma en el que estás. */
const a = (destino: string) => ruta(destino, idioma);

const redes = [
  { texto: t.instagram, link: site.links.instagram },
  { texto: t.instagramHighCoders, link: site.links.instagramHighCoders },
  { texto: t.whatsapp, link: site.links.whatsapp },
];
---

<footer class="pie">
  <Greca alto={22} variante="tres" />

  <div class="pie__caja">
    <div class="pie__marca">
      <Wordmark tam="footer" href={a('/')} />
      <p class="pie__lema">
        {t.lema1}<br />
        {txt.fechas.etiquetaLarga} · {t.lema2}
      </p>
    </div>

    <nav class="pie__columna" aria-label={t.secciones}>
      <h2 class="label pie__titulo">{t.tituloEvento}</h2>
      <a href={`${a('/')}#que-es`}>{t.queEs}</a>
      <a href={`${a('/')}#horario`}>{t.horario}</a>
      <a href={`${a('/')}#talleres`}>{t.talleres}</a>
      <a href={`${a('/')}#faq`}>{t.faq}</a>
      <a href={`${a('/')}#equipo`}>{t.equipo}</a>
    </nav>

    <nav class="pie__columna" aria-label={t.redesContacto}>
      <h2 class="label pie__titulo">{t.tituloSiguenos}</h2>
      {
        redes.map((r) =>
          disponible(r.link) ? (
            <a href={r.link.url} target="_blank" rel="noopener noreferrer">
              {r.texto}
            </a>
          ) : (
            <span class="pie__proximo">{r.texto} {t.proximo}</span>
          )
        )
      }
      <a href={`mailto:${site.contacto.email}`}>{site.contacto.email}</a>
    </nav>

    <nav class="pie__columna" aria-label={t.infoAdicional}>
      <h2 class="label pie__titulo">{t.tituloMas}</h2>
      <a href={a('/sponsors')}>{t.patrocina}</a>
      <a href={a('/legal')}>{t.legal}</a>
      <a href={`${a('/legal')}#padres`}>{t.padres}</a>
    </nav>
  </div>

  <div class="pie__base">
    <p>
      {t.organizadoPor} <a href={site.links.hackClub.url} target="_blank" rel="noopener noreferrer">{site.organizacion}</a>
      · {anio}
    </p>
    <p class="pie__nota">{t.nota}</p>
  </div>
</footer>

<style>
  .pie {
    background: var(--color-cal-2);
    border-top: 2px solid var(--color-tinta);
    margin-top: 0;
  }

  .pie__caja {
    max-width: 72rem;
    margin-inline: auto;
    padding: clamp(2.5rem, 5vw, 4rem) 1.25rem 2.5rem;
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
  }

  .pie__marca {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  .pie__lema {
    font-size: var(--text-sm);
    color: var(--color-tinta-2);
    line-height: 1.6;
  }

  .pie__columna {
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }

  .pie__titulo {
    color: var(--color-cobre-2);
    margin-bottom: 0.25rem;
  }

  .pie__columna a {
    color: var(--color-tinta);
    text-decoration: none;
    font-size: var(--text-sm);
    width: fit-content;
    border-bottom: 1px solid transparent;
    transition: border-color 0.12s ease;
  }
  .pie__columna a:hover {
    border-bottom-color: var(--color-cobre);
  }

  .pie__proximo {
    font-size: var(--text-sm);
    color: var(--color-tinta-2);
    font-style: italic;
  }

  .pie__base {
    border-top: 1px solid var(--color-cal-3);
    max-width: 72rem;
    margin-inline: auto;
    padding: 1.5rem 1.25rem 2.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    font-size: var(--text-sm);
    color: var(--color-tinta-2);
  }
  .pie__base a {
    color: var(--color-cobre-2);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .pie__nota {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (min-width: 720px) {
    .pie__caja {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
      gap: 2rem;
    }
  }
</style>
