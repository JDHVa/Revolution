---
import Wordmark from './Wordmark.astro';
import { site, disponible } from '../data/site';
import { idiomaDe, otroIdioma, ruta, rutaEnIdioma, textos } from '../i18n';

interface Props {
  pagina?: 'inicio' | 'sponsors' | 'legal';
  /**
   * 'noche' pasa la barra a la paleta oscura para las páginas cuyo hero es
   * la escena nocturna. No cambia el marcado: sólo redefine los tokens de
   * color, que es de lo que ya colgaba todo el nav. Por defecto 'dia', así
   * que el resto del sitio queda exactamente igual.
   */
  tema?: 'dia' | 'noche';
}
const { pagina = 'inicio', tema = 'dia' } = Astro.props;

const t = textos(Astro.url);
const idioma = idiomaDe(Astro.url);
const inicio = ruta('/', idioma);
const paginaSponsors = ruta('/sponsors', idioma);
const paginaLegal = ruta('/legal', idioma);

/* Desde /sponsors o /legal, las anclas tienen que apuntar a la portada —
   la del idioma en el que estás, no la de la raíz. */
const base = pagina === 'inicio' ? '' : inicio;

const enlaces = [
  { texto: t.nav.queEs, href: `${base}#que-es` },
  { texto: t.nav.horario, href: `${base}#horario` },
  { texto: t.nav.talleres, href: `${base}#talleres` },
  { texto: t.nav.faq, href: `${base}#faq` },
  { texto: t.nav.equipo, href: `${base}#equipo` },
  { texto: t.nav.patrocinio, href: paginaSponsors },
];

const registroListo = disponible(site.links.registro);

/* El cambio de idioma es un link a esta misma página del otro lado, no un
   botón con JavaScript: funciona sin JS, se puede compartir y abrir en otra
   pestaña, y Google lo sigue. */
const otro = otroIdioma(idioma);
const idiomaHref = rutaEnIdioma(Astro.url, otro);
---

<header class:list={['nav', tema === 'noche' && 'nav--noche']}>
  <div class="nav__barra">
    <Wordmark tam="nav" href={inicio} />

    <nav class="nav__enlaces" aria-label={t.ui.navPrincipal}>
      {
        enlaces.map((e) => (
          <a
            href={e.href}
            class="nav__enlace"
            aria-current={pagina === 'sponsors' && e.href === paginaSponsors ? 'page' : undefined}
          >
            {e.texto}
          </a>
        ))
      }
    </nav>

    <div class="nav__acciones">
      <a
        href={idiomaHref}
        class="label nav__idioma"
        lang={otro}
        hreflang={otro}
        aria-label={t.ui.idioma.aria}
      >
        <span aria-hidden="true">🌐</span>
        {t.ui.idioma.codigo}
      </a>

      {
        registroListo ? (
          <a href={site.links.registro.url} class="btn btn-activo nav__cta">
            {t.ui.registrarme}
          </a>
        ) : (
          <span class="nav__cta-pendiente label" title={t.ui.registroTitulo}>
            {t.ui.registroPronto}
          </span>
        )
      }

      <button
        type="button"
        class="nav__hamburguesa"
        id="navToggle"
        aria-expanded="false"
        aria-controls="navMenu"
        data-abrir={t.ui.abrirMenu}
        data-cerrar={t.ui.cerrarMenu}
      >
        <span class="sr-only">{t.ui.abrirMenu}</span>
        <span class="nav__barritas" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
      </button>
    </div>
  </div>

  <!-- Menú móvil -->
  <div class="nav__menu" id="navMenu" hidden>
    <nav aria-label={t.ui.navMovil}>
      {enlaces.map((e) => <a href={e.href} class="nav__menu-enlace">{e.texto}</a>)}
      <a href={paginaLegal} class="nav__menu-enlace">{t.nav.legal}</a>
    </nav>
    {
      registroListo ? (
        <a href={site.links.registro.url} class="btn btn-activo nav__menu-cta">
          {t.ui.registrarme}
        </a>
      ) : (
        <span class="pendiente nav__menu-cta">{t.ui.registroAbrePronto}</span>
      )
    }
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    /* Fondo opaco a propósito: un backdrop-filter aquí, encima del mosaico
       fijo, obliga al navegador a repintar la página entera en cada frame de
       scroll. En un documento de ~9000px eso tira los FPS al suelo. El blur
       no aportaba nada visualmente sobre un fondo claro y plano. */
    background: var(--color-cal);
    border-bottom: 2px solid var(--color-tinta);
  }

  /* ── Tema nocturno ───────────────────────────────── */
  /* Sólo se cambian los tokens: cada regla de abajo ya los usa, así que la
     barra entera —incluido el wordmark, que también cuelga de ellos— se pasa
     a la paleta de la calle de noche sin duplicar una sola regla. */
  .nav--noche {
    --color-cal: #1a1140; /* superficie: el mismo cielo del hero */
    --color-cal-2: #241a52;
    --color-cal-3: #3a2d6b; /* separadores */
    --color-tinta: #f5ede0; /* texto principal — 13.8:1 sobre el cielo */
    --color-tinta-2: #b9b0d8; /* secundario — 6.9:1 */
    --color-cobre: #f2c14e; /* el ámbar de las ventanas encendidas */
  }
  /* Única excepción: el CTA no invierte. Su fondo rosa no cambia, así que el
     texto tiene que seguir siendo claro; con el token volteado quedaría tinta
     oscura sobre rosa y se cae el contraste. */
  .nav--noche .nav__cta,
  .nav--noche a.nav__menu-cta {
    color: #fff;
  }

  .nav__barra {
    max-width: 78rem;
    margin-inline: auto;
    padding: 0.7rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .nav__enlaces {
    display: none;
    align-items: center;
    gap: 0.35rem;
  }

  .nav__enlace {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-tinta-2);
    text-decoration: none;
    padding: 0.45rem 0.6rem;
    border-radius: 2px;
    /* Reserva el espacio del subrayado para que el hover no mueva nada. */
    border-bottom: 2px solid transparent;
    transition:
      color 0.12s ease,
      border-color 0.12s ease;
  }
  .nav__enlace:hover,
  .nav__enlace[aria-current='page'] {
    color: var(--color-tinta);
    border-bottom-color: var(--color-cobre);
  }

  .nav__acciones {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .nav__cta {
    background: var(--color-rosa);
    color: var(--color-cal);
    padding: 0.6rem 1.1rem;
    font-size: 0.78rem;
    box-shadow: 3px 3px 0 var(--color-tinta);
  }

  /* ── Cambio de idioma ────────────────────────────── */
  /* Va en la barra fija, no en el menú móvil: así está a un toque en
     cualquier tamaño de pantalla y no se duplica el mismo control. */
  .nav__idioma {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-tinta);
    text-decoration: none;
    border: 2px solid var(--color-tinta);
    border-radius: 2px;
    padding: 0.5rem 0.7rem;
    line-height: 1;
    background: var(--color-cal);
    transition:
      background-color 0.12s ease,
      color 0.12s ease;
  }
  .nav__idioma:hover {
    background: var(--color-tinta);
    color: var(--color-cal);
  }

  .nav__cta-pendiente {
    display: none;
    color: var(--color-tinta-2);
    border: 1px dashed var(--color-tinta-2);
    border-radius: 2px;
    padding: 0.5rem 0.8rem;
  }

  /* ── Hamburguesa ─────────────────────────────────── */
  .nav__hamburguesa {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 2px solid var(--color-tinta);
    border-radius: 2px;
    background: var(--color-cal);
    cursor: pointer;
  }
  .nav__barritas {
    display: grid;
    gap: 4px;
  }
  .nav__barritas span {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--color-tinta);
    transition: transform 0.15s ease, opacity 0.15s ease;
  }
  /* Al abrir, las barras se cruzan en X. */
  .nav__hamburguesa[aria-expanded='true'] .nav__barritas span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .nav__hamburguesa[aria-expanded='true'] .nav__barritas span:nth-child(2) {
    opacity: 0;
  }
  .nav__hamburguesa[aria-expanded='true'] .nav__barritas span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* ── Menú desplegable ────────────────────────────── */
  .nav__menu {
    border-top: 1px solid var(--color-cal-3);
    background: var(--color-cal);
    padding: 1rem 1.25rem 1.5rem;
  }
  .nav__menu[hidden] {
    display: none;
  }
  .nav__menu nav {
    display: grid;
  }
  .nav__menu-enlace {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-tinta);
    text-decoration: none;
    padding: 0.85rem 0.25rem;
    border-bottom: 1px solid var(--color-cal-3);
  }
  .nav__menu-cta {
    margin-top: 1.1rem;
    width: 100%;
    background: var(--color-rosa);
    color: var(--color-cal);
    text-align: center;
  }
  span.nav__menu-cta {
    background: var(--color-cal-2);
    color: var(--color-tinta-2);
    display: block;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ── Escritorio ──────────────────────────────────── */
  @media (min-width: 900px) {
    .nav__enlaces {
      display: flex;
    }
    .nav__hamburguesa {
      display: none;
    }
    .nav__menu {
      display: none !important;
    }
    .nav__cta-pendiente {
      display: inline-block;
    }
  }
</style>

<script>
  const toggle = document.getElementById('navToggle');
  const menu = document.getElementById('navMenu');

  if (toggle && menu) {
    // Los dos rótulos vienen del servidor en data-*, ya traducidos: el script
    // no tiene que saber en qué idioma está la página.
    const rotulo = {
      abrir: toggle.dataset.abrir ?? '',
      cerrar: toggle.dataset.cerrar ?? '',
    };

    const abrir = () => {
      menu.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
      toggle.querySelector('.sr-only')!.textContent = rotulo.cerrar;
    };

    const cerrar = ({ devolverFoco = false } = {}) => {
      menu.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      toggle.querySelector('.sr-only')!.textContent = rotulo.abrir;
      if (devolverFoco) toggle.focus();
    };

    toggle.addEventListener('click', () => {
      toggle.getAttribute('aria-expanded') === 'true' ? cerrar() : abrir();
    });

    // Al elegir un destino, el menú sobra.
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) cerrar();
    });

    // Escape cierra y devuelve el foco al botón, que es donde estaba.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) cerrar({ devolverFoco: true });
    });

    // Mantiene el foco dentro del menú mientras está abierto.
    menu.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const focusables = menu.querySelectorAll<HTMLElement>('a, button');
      if (focusables.length === 0) return;
      const primero = focusables[0];
      const ultimo = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === primero) {
        e.preventDefault();
        toggle.focus();
      } else if (!e.shiftKey && document.activeElement === ultimo) {
        e.preventDefault();
        toggle.focus();
      }
    });

    // Si el viewport crece hasta escritorio, el menú móvil deja de tener sentido.
    matchMedia('(min-width: 900px)').addEventListener('change', (e) => {
      if (e.matches && !menu.hidden) cerrar();
    });
  }
</script>
