                <rect x={x + 4} y="146" width="5" height="2" fill="#1c4a31" />
                <rect x={x + 2} y="154" width="6" height="2" fill="#1c4a31" />
              </>
            ))
          }
        </g>
      </g>
    </svg>

    <!-- ══ CAPAS MODERNAS ENCIMA DEL PIXEL ════════════════ -->

    <!-- Panorámico curvo con el wordmark. Sustituye al trazo de pincel: mismo
         lugar, pero ahora es el logo de la casa (Archivo condensada en cobre,
         doble marco) montado en una valla de la calle. La curva la da un
         textPath sobre un arco, no una deformación: así el texto sigue siendo
         texto y se lee nítido a cualquier tamaño. -->
    <div
      class="idea__panoramico"
      style={`left:${izq(18)}%; top:${arrFg(80)}%; width:${ancho(110)}%`}
    >
      <svg viewBox="0 0 280 112" role="img" aria-label="REVOLUTION">
        <!-- patas de la valla -->
        <rect x="54" y="58" width="8" height="54" fill="#14121f" />
        <rect x="212" y="58" width="8" height="54" fill="#14121f" />
        <rect x="54" y="58" width="2" height="54" fill="#2b2740" />
        <rect x="212" y="58" width="2" height="54" fill="#2b2740" />
        <!-- panel -->
        <path
          d="M6 34 C 92 2, 188 2, 274 34 L274 78 C 188 46, 92 46, 6 78 Z"
          fill="#f5ede0"
          stroke="#231a15"
          stroke-width="4"
          stroke-linejoin="round"
        />
        <!-- marco interior: la doble línea del wordmark, siguiendo la curva -->
        <path
          d="M14 41 C 94 12, 186 12, 266 41 L266 71 C 186 42, 94 42, 14 71 Z"
          fill="none"
          stroke="#231a15"
          stroke-width="1.5"
        />
        <!-- riel invisible por donde corre el texto -->
        <path id="hp-arco" d="M22 65 C 96 32, 184 32, 258 65" fill="none" />
        <text class="hp-marca" fill="#c4622d">
          <textPath href="#hp-arco" startOffset="50%" text-anchor="middle">REVOLUTION</textPath>
        </text>
      </svg>
    </div>

    <!-- Letra a mano + flecha garabateada hacia Orpheus -->
    <span class="idea__mano" style={`left:${izq(178)}%; top:${arrFg(56)}%`}>Orpheus</span>
    <svg
      class="idea__flecha"
      viewBox="0 0 100 100"
      aria-hidden="true"
      style={`left:${izq(152)}%; top:${arrFg(72)}%; width:${ancho(46)}%`}
    >
      <path
        d="M88 8 C 62 6, 52 22, 66 34 C 78 45, 70 58, 56 56 C 44 54, 46 44, 58 46 C 70 48, 74 62, 62 74"
        fill="none"
        stroke="#f0b429"
        stroke-width="3.5"
        stroke-linecap="round"
      />
      <path
        d="M52 62 L62 78 L74 64"
        fill="none"
        stroke="#f0b429"
        stroke-width="3.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>

    <!-- Orpheus, parado sobre la tapa del contenedor -->
    <div
      class="idea__orpheus"
      style={`left:${izq(BASURA + 12)}%; bottom:${100 - arrFg(TAPA + 5)}%; width:${ancho(22)}%`}
    >
      <Image src={orpheus} alt="Orpheus, la mascota mariachi" widths={[180, 360]} loading="eager" />
    </div>
  </div>

  <!-- ══ TEXTO DEBAJO DEL BANNER ══════════════════════════ -->
  <div class="idea__texto">
    <p class="idea__kicker">Monterrey, MX · 2026 · idea de home</p>
    <h1 class="idea__titulo">La calle no duerme.<br /><strong>Nosotros tampoco.</strong></h1>
