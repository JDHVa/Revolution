</section>

<style>
  .idea {
    background: #1a1140;
    color: #f2ece0;
  }

  .idea__banner {
    position: relative;
    width: 100%;
    /* El aspecto lo pone el inline style, calculado desde VENTANA. Está
       clavado a propósito: si cambiara, el SVG se centraría con bandas y las
       capas en % dejarían de caer sobre el pixel que les toca. */
    overflow: hidden;
  }

  .idea__escena {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Los rótulos de dentro de la escena: van centrados en su x. */
  .idea__escena :global(.px-txt) {
