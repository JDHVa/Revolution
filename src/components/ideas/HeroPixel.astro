  /* ── Flecha ───────────────────────────────────────────── */
  .idea__flecha {
    position: absolute;
    height: auto;
    pointer-events: none;
    filter: drop-shadow(0 2px 5px rgb(0 0 0 / 0.55));
  }

  /* ── Orpheus recortado, parado en el contenedor ───────── */
  .idea__orpheus {
    position: absolute;
    pointer-events: none;
  }
  /* Un resplandor cálido detrás lo despega del cielo sin encerrarlo en una
     caja: es luz, no marco. */
  .idea__orpheus::before {
    content: '';
    position: absolute;
    inset: -20% -40%;
    background: radial-gradient(ellipse at 50% 60%, rgb(255 216 154 / 0.28), transparent 68%);
