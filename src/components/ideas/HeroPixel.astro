    font-size: 4.4px;
  }

  /* ── Deriva del fondo ─────────────────────────────────── */
  /* Cada capa recorre exactamente un ancho de cuadrícula (320) y vuelve a
     cero. Como la segunda copia va pegada a 320, en ese instante ocupa el
     lugar exacto de la primera y el salto es invisible. */
  .hp-deriva {
    animation: deriva linear infinite;
    will-change: transform;
  }
  .hp-deriva--nubes {
    animation-duration: 240s;
  }
  .hp-deriva--skyline {
    animation-duration: 110s;
  }
  @keyframes deriva {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-320px);
    }
  }

  .estrella--viva {
    animation: titilar 3.4s steps(2, end) infinite;
    animation-delay: var(--retraso, 0s);
  }
  @keyframes titilar {
    0%,
    72%,
    100% {
      opacity: 1;
    }
    82% {
      opacity: 0.2;
    }
  }

  /* ── Panorámico ───────────────────────────────────────── */
  .idea__panoramico {
    position: absolute;
    filter: drop-shadow(0 6px 14px rgb(0 0 0 / 0.5));
  }
  .idea__panoramico svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .hp-marca {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 800;
    /* El eje de ancho de Archivo: es lo que le da el aire de cartel. */
    font-stretch: 86%;
