    /* Sombra proyectada, no contorno: su cuerpo ya es claro y contrasta solo
       contra el cielo. Lo único que le faltaba era peso para no verse pegado
       con recorte de tijera sobre la escena. */
    filter: drop-shadow(0 3px 4px rgb(0 0 0 / 0.45));
  }

  /* ── Texto ────────────────────────────────────────────── */
  .idea__texto {
