---
import Section from './Section.astro';
import { Image } from 'astro:assets';
import { tiers, confirmados } from '../data/sponsors';
import { site } from '../data/site';
import { idiomaDe, ruta, textos } from '../i18n';
import logoHCB from '../assets/HCB.jpg';

const txt = textos(Astro.url);
const t = txt.sponsorsResumen;

/* El color de cada nivel está en sponsors.ts y su texto en los archivos de
   idioma, en el mismo orden. */
const niveles = tiers.map((tier, i) => ({ ...tier, ...txt.tiers[i] }));
const paginaSponsors = ruta('/sponsors', idiomaDe(Astro.url));
---

<Section
  id="sponsors"
  fondo="tinta"
  etiqueta={t.etiqueta}
  titulo={t.titulo}
  entradilla={t.entradilla}
  pcb={false}
>
  <ul class="tiers">
    {
      niveles.map((n) => (
        <li class:list={['tier', `tier--${n.color}`]}>
          <h3 class="display tier__nombre">{n.nombre}</h3>
          <p class="tier__resumen">{n.resumen}</p>
        </li>
      ))
    }
  </ul>

  <div class="sponsors__cierre">
    <p class="sponsors__pitch">
      {t.pitchInicio}<strong>{t.pitchFuerte}</strong>{t.pitchFin}
    </p>
    <div class="sponsors__acciones">
      <a href={paginaSponsors} class="btn btn-activo sponsors__cta">{t.cta}</a>
      <a href={`mailto:${site.contacto.emailSponsors}`} class="btn btn-activo sponsors__cta-2">
        {t.cta2}
      </a>
    </div>
  </div>

  <div class="donar">
    <Image src={logoHCB} alt="HCB — Hack Club Bank" width={72} height={72} class="donar__logo" />
    <div class="donar__cuerpo">
      <h3 class="display donar__titulo">{t.donarTitulo}</h3>
      <p class="donar__texto">{t.donarTexto}</p>
    </div>
    <a
      href={site.links.donar.url}
      class="btn btn-activo donar__cta"
      target="_blank"
      rel="noopener noreferrer"
    >
      {t.donar}
    </a>
  </div>

  {
    confirmados.length > 0 && (
      <div class="sponsors__confirmados">
        <p class="label sponsors__confirmados-titulo">{t.confirmados}</p>
        <ul>
          {confirmados.map((c) => (
            <li>
              <a href={c.url} target="_blank" rel="noopener noreferrer">
                <img src={`/media/sponsors/${c.logo}`} alt={c.nombre} loading="lazy" height="44" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</Section>

<style>
  .tiers {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.25rem;
  }

  .tier {
    border: 1px solid color-mix(in srgb, var(--color-cal) 22%, transparent);
    border-radius: 2px;
    padding: 1.4rem;
    /* La barra de color es lo único que distingue un nivel de otro:
       sin ella todas las tarjetas se verían iguales. */
    border-top: 4px solid var(--tier-color);
  }

  /* Todos los acentos de esta sección van sobre tinta, así que son las
     variantes claras. Los tonos base están calibrados para fondo cal y
     aquí se quedarían por debajo de AA. */
  .tier--cobre {
    --tier-color: var(--color-cobre-claro);
  }
  .tier--agave {
    --tier-color: #58b494;
  }
  .tier--talavera {
    --tier-color: #7ba7e0;
  }
  .tier--rosa {
    --tier-color: #ef6f95;
  }

  .tier__nombre {
    font-size: var(--text-xl);
    color: var(--tier-color);
    margin-bottom: 0.5rem;
  }

  .tier__resumen {
    color: color-mix(in srgb, var(--color-cal) 72%, transparent);
    font-size: var(--text-base);
  }

  /* ── Cierre ──────────────────────────────────────── */
  .sponsors__cierre {
    margin-top: 2.5rem;
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  .sponsors__pitch {
    font-size: var(--text-lg);
    color: color-mix(in srgb, var(--color-cal) 78%, transparent);
    max-width: 52ch;
  }
  .sponsors__pitch strong {
    color: var(--color-cal);
    font-weight: 600;
  }

  .sponsors__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .sponsors__cta {
    /* Cobre claro con texto tinta = 5.6:1. La combinación intuitiva
       (cobre + texto claro) se queda en 3.5:1 y no pasa AA. */
    background: var(--color-cobre-claro);
    color: var(--color-tinta);
    border-color: var(--color-cal);
    box-shadow: 4px 4px 0 var(--color-cal);
  }
  .sponsors__cta-2 {
    background: transparent;
    color: var(--color-cal);
    border-color: var(--color-cal);
    box-shadow: 4px 4px 0 var(--color-cal);
  }
  .sponsors__cta:hover,
  .sponsors__cta-2:hover {
    box-shadow: 2px 2px 0 var(--color-cal);
  }
  .sponsors__cta:active,
  .sponsors__cta-2:active {
    box-shadow: 0 0 0 var(--color-cal);
  }

  /* ── Donación HCB ────────────────────────────────── */
  .donar {
    margin-top: 2.5rem;
    padding: 1.5rem;
    border: 1px solid color-mix(in srgb, var(--color-cal) 22%, transparent);
    border-radius: 2px;
    border-left: 4px solid var(--color-rosa);
    display: grid;
    gap: 1.1rem 1.35rem;
    align-items: center;
  }

  .donar__logo {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 12px;
    display: block;
  }

  .donar__titulo {
    font-size: var(--text-lg);
    color: var(--color-cal);
    margin-bottom: 0.35rem;
  }

  .donar__texto {
    color: color-mix(in srgb, var(--color-cal) 72%, transparent);
    font-size: var(--text-base);
    max-width: 60ch;
  }

  .donar__cta {
    background: var(--color-rosa);
    color: var(--color-cal);
    border-color: var(--color-cal);
    box-shadow: 4px 4px 0 var(--color-cal);
    justify-self: start;
  }
  .donar__cta:hover {
    box-shadow: 2px 2px 0 var(--color-cal);
  }
  .donar__cta:active {
    box-shadow: 0 0 0 var(--color-cal);
  }

  @media (min-width: 720px) {
    .donar {
      grid-template-columns: auto 1fr auto;
    }
    .donar__cta {
      justify-self: end;
    }
  }

  /* ── Logos confirmados ───────────────────────────── */
  .sponsors__confirmados {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid color-mix(in srgb, var(--color-cal) 22%, transparent);
  }
  .sponsors__confirmados-titulo {
    color: var(--color-cobre-claro);
    margin-bottom: 1.25rem;
  }
  .sponsors__confirmados ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2rem;
  }

  @media (min-width: 720px) {
    .tiers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .tiers {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .sponsors__cierre {
      grid-template-columns: 1fr auto;
      gap: 2.5rem;
    }
  }
</style>
